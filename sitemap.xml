---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" 
  xmlns:image="http://www.google.com/schemas/sitemap-image/1.1" 
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {% for page in site.posts %}
  <url>
    <loc>{{ site.url }}{{ page.url | replace: 'index.html', '' }}</loc>
    <image:image>
    {% if page.image != null %}
    <image:loc>{{site.url}}{{page.image}}</image:loc>
    {% else %}
    <image:loc>{{site.url}}{{site.image}}</image:loc>
    {% endif %}
    </image:image>
    {% if page.lastmod %}<lastmod>{{ page.lastmod | date_to_xmlschema }}</lastmod>{% endif %}
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}
  {% for page in site.pages %}
  {% if page.url contains '.xml' or page.url contains 'assets' %}{% else %}
  <url>
    <loc>{{ site.url }}{{ page.url }}</loc>
    <image:image>
    {% if page.image != null %}
    <image:loc>{{site.url}}{{page.image}}</image:loc>
    {% else %}
    <image:loc>{{site.url}}{{site.image}}</image:loc>
    {% endif %}
    </image:image>
    {% if page.lastmod %}<lastmod>{{ page.lastmod | date_to_xmlschema }}</lastmod>{% endif %}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  {% endif %}
  {% endfor %}
</urlset>
